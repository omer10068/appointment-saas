generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  USER
  SUPPORT
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INVITED
  BLOCKED
  DISABLED
}

enum BusinessStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  CANCELLED
}

enum BusinessUserRole {
  OWNER
  MANAGER
  MEMBER
}

enum BusinessUserStatus {
  INVITED
  ACTIVE
  BLOCKED
}

enum CustomerStatus {
  ACTIVE
  BLOCKED
  ARCHIVED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_BUSINESS
  COMPLETED
  NO_SHOW
}

model User {
  id              String    @id @default(uuid())
  clerkUserId     String?   @unique

  email           String?   @unique
  phoneNormalized String    @unique
  phoneVerifiedAt DateTime?

  status       UserStatus   @default(ACTIVE)
  platformRole PlatformRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessUsers    BusinessUser[]
  customerProfiles CustomerProfile[]
}

model Business {
  id     String         @id @default(uuid())
  name   String
  slug   String         @unique
  status BusinessStatus @default(TRIAL)

  timezone String @default("Asia/Jerusalem")
  locale   String @default("he-IL")
  currency String @default("ILS")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessUsers          BusinessUser[]
  services               Service[]
  staffMembers           StaffMember[]
  businessCustomers      BusinessCustomer[]
  appointments           Appointment[]
  businessWorkingHours   BusinessWorkingHour[]
  staffWorkingHours      StaffWorkingHour[]
  availabilityExceptions AvailabilityException[]
}

model BusinessUser {
  id         String             @id @default(uuid())
  businessId String
  userId     String

  role   BusinessUserRole
  status BusinessUserStatus @default(INVITED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business    Business     @relation(fields: [businessId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  staffMember StaffMember?

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
}

model CustomerProfile {
  id     String  @id @default(uuid())
  userId String?

  fullName        String
  email           String?
  phoneNormalized String    @unique
  phoneVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User?              @relation(fields: [userId], references: [id])
  businessCustomers BusinessCustomer[]

  @@index([userId])
}

model BusinessCustomer {
  id                String         @id @default(uuid())
  businessId        String
  customerProfileId String

  status CustomerStatus @default(ACTIVE)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business        Business        @relation(fields: [businessId], references: [id])
  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id])
  appointments    Appointment[]

  @@unique([businessId, customerProfileId])
  @@index([businessId])
  @@index([customerProfileId])
}

model Service {
  id         String  @id @default(uuid())
  businessId String

  name            String
  description     String?
  durationMinutes Int
  priceCents      Int?
  isActive        Boolean @default(true)

  bufferBeforeMin Int @default(0)
  bufferAfterMin  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business     Business             @relation(fields: [businessId], references: [id])
  appointments Appointment[]
  staffMembers StaffMemberService[]

  @@index([businessId])
}

model StaffMember {
  id             String  @id @default(uuid())
  businessId     String
  businessUserId String  @unique

  displayName String
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business               Business               @relation(fields: [businessId], references: [id])
  businessUser           BusinessUser           @relation(fields: [businessUserId], references: [id])
  appointments           Appointment[]
  services               StaffMemberService[]
  staffWorkingHours      StaffWorkingHour[]
  availabilityExceptions AvailabilityException[]

  @@index([businessId])
}

// Join table: which Services a StaffMember can provide
model StaffMemberService {
  staffMemberId String
  serviceId     String

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffMemberId, serviceId])
  @@index([serviceId])
}

model Appointment {
  id                 String            @id @default(uuid())
  businessId         String
  businessCustomerId String
  serviceId          String
  staffMemberId      String

  startsAt DateTime
  endsAt   DateTime
  status   AppointmentStatus @default(SCHEDULED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business         Business         @relation(fields: [businessId], references: [id])
  businessCustomer BusinessCustomer @relation(fields: [businessCustomerId], references: [id])
  service          Service          @relation(fields: [serviceId], references: [id])
  staffMember      StaffMember      @relation(fields: [staffMemberId], references: [id])

  @@index([businessId, startsAt])
  @@index([businessCustomerId])
  @@index([serviceId])
  @@index([staffMemberId, startsAt])
}

model BusinessWorkingHour {
  id         String   @id @default(uuid())
  businessId String
  dayOfWeek  Int
  startTime  String?
  endTime    String?
  isClosed   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

model StaffWorkingHour {
  id            String   @id @default(uuid())
  businessId    String
  staffMemberId String
  dayOfWeek     Int
  startTime     String?
  endTime       String?
  isClosed      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business    Business    @relation(fields: [businessId], references: [id])
  staffMember StaffMember @relation(fields: [staffMemberId], references: [id])

  @@unique([staffMemberId, dayOfWeek])
  @@index([businessId])
  @@index([staffMemberId])
}

model AvailabilityException {
  id            String    @id @default(uuid())
  businessId    String
  staffMemberId String?
  date          DateTime
  startTime     String?
  endTime       String?
  isClosed      Boolean   @default(false)
  reason        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business    Business     @relation(fields: [businessId], references: [id])
  staffMember StaffMember? @relation(fields: [staffMemberId], references: [id])

  @@index([businessId])
  @@index([staffMemberId])
  @@index([date])
}
